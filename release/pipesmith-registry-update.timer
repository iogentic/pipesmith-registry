# Runs pipesmith-registry-update.service every hour, so a window of
# update.json of a few hours is met. Installed disabled:
# systemctl enable --now pipesmith-registry-update.timer turns it on.
[Unit]
Description=Hourly update check of Pipesmith Registry

[Timer]
OnCalendar=hourly
RandomizedDelaySec=10min
Persistent=true
Unit=pipesmith-registry-update.service

[Install]
WantedBy=timers.target

# Runs pipesmith-registry-update.service once a day. Installed disabled:
# systemctl enable --now pipesmith-registry-update.timer turns it on.
[Unit]
Description=Daily update check of Pipesmith Registry

[Timer]
OnCalendar=daily
RandomizedDelaySec=1h
Persistent=true
Unit=pipesmith-registry-update.service

[Install]
WantedBy=timers.target

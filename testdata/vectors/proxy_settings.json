    "want": {"members": ["demo-hosted"], "writable_member": ""}},
   {"name": "a writable member that is no text",
    "group": {"name": "demo-group", "format": "maven2", "type": "group", "members": ["demo-hosted"]},
    "attributes": {"group": {"memberNames": ["demo-hosted"], "groupWriteMember": ["demo-hosted"]}},
    "error": "repository \"demo-group\": group.groupWriteMember is not a text"},
   {"name": "a group section that is no object",

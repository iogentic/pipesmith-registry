   "attributes": null,
   "error": "repository \"demo-nonsense\": the remote address cannot be read as an address"},
  {"name": "an address as a number",
   "repo": {"name": "demo-number-url", "format": "maven2", "type": "proxy", "remote_url": "https://repo.example.com/maven2/"},
   "attributes": {"proxy": {"remoteUrl": 7}},
   "error": "repository \"demo-number-url\": proxy.remoteUrl is not a text"},
  {"name": "a proxy section that is a list",
   "repo": {"name": "demo-proxy-list", "format": "maven2", "type": "proxy", "remote_url": "https://repo.example.com/maven2/"},
   "attributes": {"proxy": ["https://repo.example.com/maven2/"]},
   "error": "repository \"demo-proxy-list\": proxy is not an object"},
  {"name": "a hosted repository has no proxy settings",
   "repo": {"name": "demo-hosted", "format": "maven2", "type": "hosted"},
   "attributes": {"storage": {"writePolicy": "ALLOW"}},
   "error": "repository \"demo-hosted\" is hosted, not a proxy"},
  {"name": "the routing rule the repository names (task 4 stores the link)",
   "repo": {"name": "demo-routed", "format": "maven2", "type": "proxy", "remote_url": "https://repo.example.com/maven2/", "routing_rule": "demo-block-internal"},
   "attributes": null,
   "want": {"remote_url": "https://repo.example.com/maven2/", "content_max_age": 1440, "metadata_max_age": 1440, "not_found_cache": true, "not_found_ttl": 1440, "blocked": false, "auto_block": true, "auth": {}, "retries": 2, "timeout_seconds": 20, "routing_rule": "demo-block-internal"}}
 ],
 "group": {
  "repositories": [
   {"name": "demo-hosted", "format": "maven2", "type": "hosted"},
   {"name": "demo-hosted-b", "format": "maven2", "type": "hosted"},
   {"name": "demo-proxy", "format": "maven2", "type": "proxy", "remote_url": "https://repo.example.com/maven2/"},
   {"name": "demo-npm-hosted", "format": "npm", "type": "hosted"},
   {"name": "demo-inner", "format": "maven2", "type": "group", "members": ["demo-hosted-b"]}
  ],
  "cases": [
   {"name": "members of repositories.json without attributes",
    "group": {"name": "demo-group", "format": "maven2", "type": "group", "members": ["demo-proxy", "demo-hosted"]},
    "attributes": null,
    "want": {"members": ["demo-proxy", "demo-hosted"], "writable_member": ""}},
   {"name": "the stored member names override the definition",
    "group": {"name": "demo-group", "format": "maven2", "type": "group", "members": ["demo-proxy"]},
    "attributes": {"group": {"memberNames": ["demo-hosted", "demo-proxy"]}},
    "want": {"members": ["demo-hosted", "demo-proxy"], "writable_member": ""}},
   {"name": "a writable hosted member of the same format that the group lists",
    "group": {"name": "demo-group", "format": "maven2", "type": "group", "members": ["demo-proxy", "demo-hosted"]},
    "attributes": {"group": {"memberNames": ["demo-proxy", "demo-hosted"], "groupWriteMember": "demo-hosted"}},
    "want": {"members": ["demo-proxy", "demo-hosted"], "writable_member": "demo-hosted"}},
   {"name": "a writable member the group does not list",
    "group": {"name": "demo-group", "format": "maven2", "type": "group", "members": ["demo-proxy"]},
    "attributes": {"group": {"memberNames": ["demo-proxy"], "groupWriteMember": "demo-hosted"}},
    "error": "repository \"demo-group\": group.groupWriteMember names demo-hosted, which the group does not list"},
   {"name": "a writable member that only a group inside the group lists",
    "group": {"name": "demo-group", "format": "maven2", "type": "group", "members": ["demo-inner", "demo-hosted"]},
    "attributes": {"group": {"memberNames": ["demo-inner", "demo-hosted"], "groupWriteMember": "demo-hosted-b"}},
    "error": "repository \"demo-group\": group.groupWriteMember names demo-hosted-b, which the group does not list"},
   {"name": "a proxy as the writable member",
    "group": {"name": "demo-group", "format": "maven2", "type": "group", "members": ["demo-proxy", "demo-hosted"]},
    "attributes": {"group": {"memberNames": ["demo-proxy", "demo-hosted"], "groupWriteMember": "demo-proxy"}},
    "error": "repository \"demo-group\": group.groupWriteMember names demo-proxy, a proxy, not a hosted repository"},
   {"name": "a group as the writable member",
    "group": {"name": "demo-group", "format": "maven2", "type": "group", "members": ["demo-inner"]},
    "attributes": {"group": {"memberNames": ["demo-inner"], "groupWriteMember": "demo-inner"}},
    "error": "repository \"demo-group\": group.groupWriteMember names demo-inner, a group, not a hosted repository"},
   {"name": "a writable member of another format",
    "group": {"name": "demo-group", "format": "maven2", "type": "group", "members": ["demo-npm-hosted", "demo-hosted"]},
    "attributes": {"group": {"memberNames": ["demo-npm-hosted", "demo-hosted"], "groupWriteMember": "demo-npm-hosted"}},
    "error": "repository \"demo-group\": group.groupWriteMember names demo-npm-hosted of format npm, not maven2"},
   {"name": "a writable member that does not exist",
    "group": {"name": "demo-group", "format": "maven2", "type": "group", "members": ["demo-hosted", "demo-gone"]},
    "attributes": {"group": {"memberNames": ["demo-hosted", "demo-gone"], "groupWriteMember": "demo-gone"}},
    "error": "repository \"demo-group\": group.groupWriteMember names demo-gone, which does not exist"},
   {"name": "member names that are no list",
    "group": {"name": "demo-group", "format": "maven2", "type": "group", "members": ["demo-hosted"]},
    "attributes": {"group": {"memberNames": "demo-hosted"}},
    "error": "repository \"demo-group\": group.memberNames is not a list of names"},
   {"name": "member names with a number",
